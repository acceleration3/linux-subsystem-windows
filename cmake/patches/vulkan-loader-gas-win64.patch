--- a/loader/unknown_ext_chain_gas_x86.S
+++ b/loader/unknown_ext_chain_gas_x86.S
@@ -37,6 +37,49 @@
 
 .ifdef X86_64
 
+#if defined(_WIN32)
+/* The Windows x64 calling convention: the first four arguments in rcx, rdx,
+ * r8 and r9, 32 bytes of shadow space above the return address, and the rest
+ * on the stack after it. A MinGW build assembles this file, and a trampoline
+ * that took its handle from rdi read garbage there. */
+.macro PhysDevExtTramp num
+.global vkPhysDevExtTramp\num
+vkPhysDevExtTramp\num:
+    mov     rax, [rcx]
+    mov     rcx, [rcx + PHYS_DEV_OFFSET_PHYS_DEV_TRAMP]
+    jmp     [rax + (PHYS_DEV_OFFSET_INST_DISPATCH + (PTR_SIZE * \num))]
+.endm
+
+.macro PhysDevExtTermin num
+.global vkPhysDevExtTermin\num
+vkPhysDevExtTermin\num:
+    mov     rax, [rcx + ICD_TERM_OFFSET_PHYS_DEV_TERM]                          # Store the loader_icd_term* in rax
+    cmp     qword ptr [rax + (DISPATCH_OFFSET_ICD_TERM + (PTR_SIZE * \num))], 0 # Check if the next function in the chain is NULL
+    je      terminError\num                                                     # Go to the error section if it is NULL
+    mov     rcx, [rcx + PHYS_DEV_OFFSET_PHYS_DEV_TERM]                          # Load the unwrapped VkPhysicalDevice into the first arg
+    jmp     [rax + (DISPATCH_OFFSET_ICD_TERM + (PTR_SIZE * \num))]              # Jump to the next function in the chain
+terminError\num:
+    sub     rsp, 56                                                             # Shadow space and the fifth argument, rsp 16-aligned
+    mov     rcx, [rax + INSTANCE_OFFSET_ICD_TERM]                               # The loader_instance (first arg)
+    mov     edx, VULKAN_LOADER_ERROR_BIT                                        # The error logging bit (second arg)
+    xor     r8d, r8d                                                            # Zero (third arg)
+    lea     r9, [rip + termin_error_string]                                     # The error string (fourth arg)
+    mov     rax, [rcx + (FUNCTION_OFFSET_INSTANCE + (CHAR_PTR_SIZE * \num))]
+    mov     [rsp + 32], rax                                                     # The func name (fifth arg)
+    call    loader_log                                                          # Log the error message before we crash
+    add     rsp, 56
+    mov     rax, 0
+    jmp     rax                                                                 # Crash intentionally by jumping to address zero
+.endm
+
+.macro DevExtTramp num
+.global vkdev_ext\num
+vkdev_ext\num:
+    mov     rax, [rcx]                                                          # Dereference the handle to get the dispatch table
+    jmp     [rax + (EXT_OFFSET_DEVICE_DISPATCH + (PTR_SIZE * \num))]            # Jump to the appropriate call chain
+.endm
+
+#else
 .macro PhysDevExtTramp num
 .global vkPhysDevExtTramp\num
 #if defined(__ELF__)
@@ -85,6 +128,8 @@
     jmp     [rax + (EXT_OFFSET_DEVICE_DISPATCH + (PTR_SIZE * \num))]            # Jump to the appropriate call chain
 .endm
 
+#endif
+
 .else
 
 .macro PhysDevExtTramp num
