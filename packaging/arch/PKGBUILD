# Maintainer: acceleration3 <acceleration23 at gmail dot com>

_root="$(realpath "${startdir}/../..")"
source "${_root}/packaging/aur/PKGBUILD"

_tarball="$(printf '%s\n' "${_root}"/dist/lsw-*-x86_64.tar.zst | sort -V | tail -1)"
if [[ ! -f "${_tarball}" ]]; then
    error "No release tarball in ${_root}/dist; run scripts/dist.sh arch first."
    exit 1
fi
pkgver="$(basename "${_tarball}" | sed 's/^lsw-\(.*\)-x86_64\.tar\.zst$/\1/')"
pkgrel=1
source=()
sha256sums=()

package() {
    (cd "${_root}/dist" && sha256sum --quiet -c "lsw-${pkgver}-x86_64.tar.zst.sha256")
    bsdtar -xf "${_tarball}" -C "${pkgdir}" --no-same-owner
    mv "${pkgdir}/usr/share/licenses/lsw" "${pkgdir}/usr/share/licenses/${pkgname}"
}
