<domain type='kvm' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
  <name>{{domain_name}}</name>
  <uuid>{{uuid}}</uuid>
  <memory unit='MiB'>{{ram_mib}}</memory>
  <memoryBacking>
    <source type='memfd'/>
    <access mode='shared'/>
  </memoryBacking>
  <currentMemory unit='MiB'>{{ram_mib}}</currentMemory>
  <vcpu placement='static'>{{cpus}}</vcpu>

  <os firmware='efi'>
    <type arch='x86_64' machine='q35'>hvm</type>
    <firmware>
      <feature enabled='no' name='enrolled-keys'/>
      <feature enabled='no' name='secure-boot'/>
    </firmware>
    <loader readonly='yes' type='pflash'/>
    <nvram>{{nvram_path}}</nvram>
    <bootmenu enable='no'/>
  </os>

  <features>
    <acpi/>
    <apic/>
    <hyperv mode='custom'>
      <relaxed         state='on'/>
      <vapic           state='on'/>
      <spinlocks       state='on' retries='8191'/>
      <vpindex         state='on'/>
      <synic           state='on'/>
      <stimer          state='on'/>
      <runtime         state='on'/>
      <reset           state='on'/>
      <frequencies     state='on'/>
      <reenlightenment state='on'/>
      <tlbflush        state='on'/>
      <ipi             state='on'/>
    </hyperv>
    <vmport state='off'/>
  </features>

  <cpu mode='host-passthrough' check='none' migratable='on'>
    <topology sockets='1' dies='1' cores='{{cpus}}' threads='1'/>
    <feature policy='disable' name='hle'/>
    <feature policy='disable' name='rtm'/>
    <feature policy='require' name='invtsc'/>
  </cpu>

  <clock offset='localtime'>
    <timer name='rtc'         tickpolicy='catchup'/>
    <timer name='pit'         tickpolicy='delay'/>
    <timer name='hpet'        present='no'/>
    <timer name='tsc'         present='yes' mode='native'/>
    <timer name='kvmclock'    present='no'/>
    <timer name='hypervclock' present='yes'/>
  </clock>

  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>restart</on_crash>

  <devices>
    <emulator>{{emulator}}</emulator>

    <controller type='usb' index='0' model='qemu-xhci' ports='15'/>
    <input type='tablet' bus='usb'/>
    <input type='mouse' bus='ps2'/>
    <input type='keyboard' bus='ps2'/>

    <controller type='nvme' index='0'/>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'
              cache='none' io='threads' discard='unmap' detect_zeroes='unmap'/>
      <source file='{{disk_path}}'/>
      <target dev='nvme0n1' bus='nvme'/>
      <serial>LSW-SYSTEM</serial>
      <boot order='1'/>
      <address type='drive' controller='0' bus='0' target='0' unit='0'/>
    </disk>

    <disk type='file' device='cdrom'>
      <driver name='qemu' type='qcow2'/>
      <source file='{{install_media}}' startupPolicy='optional'/>
      <target dev='sdb' bus='sata'/>
      <readonly/>
      <boot order='2'/>
    </disk>

    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='{{payload_iso}}'/>
      <target dev='sdc' bus='sata'/>
      <readonly/>
    </disk>

{{video_inner}}
{{graphics_inner}}

    <sound model='ich9'>
      <audio id='1'/>
    </sound>
    <audio id='1' type='pipewire'/>

    <memballoon model='none'/>
{{host_shares_inner}}

    <panic model='isa'/>
  </devices>

  <qemu:commandline>
{{qemu_env_inner}}
{{gpu_args_inner}}
{{input_args_inner}}
    <qemu:arg value='-netdev'/>
    <qemu:arg value='user,id=lsw-net,hostfwd=tcp:127.0.0.1:5102-:5102,hostfwd=tcp:127.0.0.1:5103-:5103,hostfwd=tcp:127.0.0.1:5445-:445'/>
    <qemu:arg value='-device'/>
    <qemu:arg value='e1000e,netdev=lsw-net,id=lsw-nic,bus=pcie.0,addr=0x10'/>
  </qemu:commandline>
</domain>
