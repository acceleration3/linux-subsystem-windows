QWidget {
    color: #e4e8f0;
    font-family: "Archivo", "Inter", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog, QWizardPage {
    background-color: #0d0f14;
}

QWizard {
    background-color: #0d0f14;
}

QLabel, QCheckBox, QRadioButton, QGroupBox {
    background: transparent;
}

QScrollArea, QAbstractScrollArea, QAbstractScrollArea > QWidget > QWidget {
    background: transparent;
}

QToolTip {
    background-color: #1c212c;
    color: #e4e8f0;
    border: 1px solid #272d3a;
    padding: 4px 7px;
}

QLabel#Mono, QLineEdit#Mono, QPlainTextEdit#Mono, QLabel#Meta {
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
}

QLabel#Meta {
    color: #646d7e;
    font-size: 11px;
}

QLabel#Dim {
    color: #9aa3b4;
}

QLabel#Body {
    color: #9aa3b4;
    font-size: 12px;
}

QLabel#Caption {
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 10px;
    letter-spacing: 1.4px;
    color: #646d7e;
}

QLabel#Heading {
    font-size: 15px;
    font-weight: 600;
}

QPushButton {
    background-color: #1c212c;
    color: #e4e8f0;
    border: 1px solid #272d3a;
    border-top: 1px solid #39415a;
    border-radius: 5px;
    padding: 5px 13px;
    min-height: 20px;
    font-weight: 500;
}

QPushButton:hover   { background-color: #242a37; border-color: #39415a; }
QPushButton:pressed { background-color: #2c3444; }

QPushButton:checked {
    background-color: #2c3444;
    border-color: #4a536b;
}

QPushButton:disabled {
    background-color: #161a22;
    border: 1px solid #20252f;
    color: #4d5566;
}

QPushButton#Primary {
    background-color: #ff9f45;
    border: 1px solid #c97a2d;
    color: #17120b;
    font-weight: 600;
}
QPushButton#Primary:hover   { background-color: #ffb066; }
QPushButton#Primary:pressed { background-color: #e8913f; }
QPushButton#Primary:disabled {
    background-color: #4a3a26;
    border-color: #4a3a26;
    color: #8a7358;
}

QPushButton#Quiet {
    background-color: transparent;
    border: 1px solid transparent;
    color: #9aa3b4;
}
QPushButton#Quiet:hover { background-color: #1c212c; color: #e4e8f0; }

QPushButton#Go:enabled   { color: #4ec98a; }
QPushButton#Stop:enabled { color: #f2555a; }

QPushButton#IconButton {
    padding: 0px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    color: #9aa3b4;
}

QToolButton#IconTool {
    background-color: #1c212c;
    border: 1px solid #272d3a;
    border-radius: 3px;
    padding: 0px;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
}
QToolButton#IconTool:hover {
    background-color: #242a37;
    border-color: #272d3a;
}
QToolButton#IconTool[popupMode="2"] {
    min-width: 40px;
    max-width: 40px;
    padding: 0px 14px 0px 4px;
}
QToolButton#IconTool::menu-indicator {
    image: url(:/lsw/caret.png);
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 6px;
    width: 8px;
    height: 5px;
}

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 12px;
}

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #0f131a;
    border: 1px solid #272d3a;
    border-radius: 5px;
    padding: 5px 9px;
    color: #e4e8f0;
    selection-background-color: #ff9f45;
    selection-color: #17120b;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #ff9f45;
}

QLineEdit:disabled, QPlainTextEdit:disabled, QSpinBox:disabled {
    background-color: #12161d;
    color: #4d5566;
}

QSpinBox::up-button, QSpinBox::down-button {
    width: 0px;
    border: none;
    background: transparent;
}

QComboBox {
    background-color: #0f131a;
    border: 1px solid #272d3a;
    border-radius: 5px;
    padding: 5px 9px;
    color: #e4e8f0;
}
QComboBox:hover { border-color: #39415a; }
QComboBox:focus { border-color: #ff9f45; }
QComboBox:disabled { background-color: #12161d; color: #4d5566; }

QComboBox::drop-down {
    border: none;
    width: 18px;
}
QComboBox::down-arrow {
    image: url(:/lsw/caret.png);
    width: 12px;
    height: 7px;
    margin-right: 8px;
}
QComboBox::down-arrow:disabled {
    image: url(:/lsw/caret-disabled.png);
}
QComboBox QAbstractItemView {
    background-color: #151922;
    border: 1px solid #272d3a;
    selection-background-color: #242a37;
    selection-color: #e4e8f0;
    outline: none;
    padding: 3px;
}

QCheckBox, QRadioButton {
    spacing: 8px;
    background: transparent;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #20252f;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #ff9f45;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 13px;
    height: 13px;
    margin: -5px 0;
    border-radius: 7px;
    background: #e4e8f0;
    border: 2px solid #0d0f14;
}
QSlider::handle:horizontal:hover { background: #ffffff; }

QProgressBar {
    background-color: #20252f;
    border: none;
    border-radius: 3px;
    height: 6px;
    max-height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #ff9f45;
    border-radius: 3px;
}

QListWidget, QListView, QTreeView, QTableWidget, QTableView {
    background-color: #151922;
    border: 1px solid #272d3a;
    border-radius: 5px;
    outline: none;
    alternate-background-color: #171c25;
}

QTableWidget#Rows, QTableView#Rows {
    background: transparent;
    border: none;
    border-radius: 0px;
    gridline-color: transparent;
}
QTableWidget#Rows::item, QTableView#Rows::item {
    border-bottom: 1px solid #1b202a;
    padding: 9px 12px;
}
QTableWidget#Rows[controls="true"]::item {
    padding: 0px 12px;
}
QTableWidget#Rows QHeaderView, QTableView#Rows QHeaderView {
    background: transparent;
    border: none;
}
QTableWidget#Rows QHeaderView::section, QTableView#Rows QHeaderView::section {
    background: transparent;
    border: none;
    border-bottom: 1px solid #272d3a;
    border-right: 1px solid transparent;
    padding: 0px 12px 7px 12px;
}
QTableWidget#Rows QHeaderView::section:hover, QTableView#Rows QHeaderView::section:hover {
    border-right: 1px solid #394152;
}
QListWidget#StoreApps, QWidget#StoreAppsEmpty {
    background-color: #0d0f14;
    border: none;
    border-top: 1px solid #272d3a;
    border-radius: 0px;
}
QListWidget#StoreApps > QWidget {
    background-color: #0d0f14;
}
QListWidget#StoreApps::item {
    padding: 0px;
    border-radius: 0px;
}

QHeaderView::section {
    background: transparent;
    color: #646d7e;
    border: none;
    border-bottom: 1px solid #272d3a;
    padding: 0px 12px 7px 12px;
}
QTableWidget#Rows QTableCornerButton::section {
    background: transparent;
    border: none;
}

QListWidget::item, QTreeView::item {
    padding: 4px;
    border-radius: 4px;
}
QListWidget::item:hover, QTreeView::item:hover {
    background-color: #1c212c;
}
QListWidget::item:selected, QTreeView::item:selected,
QTableView::item:selected {
    background-color: #241d14;
    color: #e4e8f0;
}

QHeaderView::section {
    background-color: #131720;
    color: #646d7e;
    border: none;
    border-bottom: 1px solid #272d3a;
    padding: 6px 10px;
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 10px;
    font-weight: 500;
}

QTableWidget, QTableView {
    gridline-color: #1b202a;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #2b3240;
    border-radius: 5px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover { background: #39415a; }

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}
QScrollBar::handle:horizontal {
    background: #2b3240;
    border-radius: 5px;
    min-width: 28px;
}
QScrollBar::handle:horizontal:hover { background: #39415a; }

QScrollBar::add-line, QScrollBar::sub-line { height: 0px; width: 0px; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

QFrame#Panel {
    background-color: #151922;
    border: 1px solid #272d3a;
    border-radius: 5px;
}

QFrame#OptionCard {
    background-color: #151922;
    border: 1px solid #272d3a;
    border-radius: 5px;
}
QFrame#OptionCard:hover {
    background-color: #1c212c;
}
QFrame#OptionCard[selected="true"] {
    background-color: #1b1a19;
    border: 1px solid #a8672a;
}

QLabel#IconSlot {
    background-color: #0f131a;
    border: 1px dashed #272d3a;
    border-radius: 10px;
    color: #646d7e;
}

QWidget#Tile {
    background-color: #151922;
}

QFrame#KpiGrid {
    background-color: #272d3a;
    border: 1px solid #272d3a;
    border-radius: 3px;
}

QLabel#KpiValue {
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 15px;
    color: #e4e8f0;
}

QLabel#CardName {
    font-size: 13px;
    font-weight: 600;
}

QLabel#Term {
    background-color: #05070a;
    color: #646d7e;
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 11px;
    padding: 9px 14px;
}

QFrame#Screen {
    background-color: #05070a;
    border: 1px solid #272d3a;
    border-radius: 5px;
}

QSpinBox#SliderValue {
    background: transparent;
    border: none;
    padding: 4px 2px;
    color: #e4e8f0;
}

QLabel#ScreenTag {
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 9px;
    letter-spacing: 1.2px;
    color: #646d7e;
    border: 1px solid #272d3a;
    border-radius: 2px;
    padding: 2px 6px;
    background: rgba(11, 14, 19, 204);
}

QLabel#Callout {
    background-color: #1d1712;
    border-left: 2px solid #ff9f45;
    border-radius: 0px 3px 3px 0px;
    color: #f0c393;
    padding: 10px 13px;
}
QLabel#CalloutCritical {
    background-color: #1f1315;
    border-left: 2px solid #f2555a;
    border-radius: 0px 3px 3px 0px;
    color: #f0b0b2;
    padding: 10px 13px;
}

QProgressBar#Meter::chunk { background-color: #4ec98a; border-radius: 3px; }
QProgressBar#Meter[pressure="hot"]::chunk  { background-color: #ff9f45; }
QProgressBar#Meter[pressure="crit"]::chunk { background-color: #f2555a; }

QWidget#PanelHeader {
    background-color: #131720;
    border-bottom: 1px solid #272d3a;
}

QWidget#ListFoot {
    background-color: #131720;
    border-top: 1px solid #272d3a;
}

QFrame#Separator {
    background-color: #272d3a;
    max-height: 1px;
    border: none;
}

QGroupBox {
    border: 1px solid #272d3a;
    border-radius: 5px;
    margin-top: 12px;
    padding: 10px 8px 8px 8px;
    background-color: #151922;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #646d7e;
}

QSplitter::handle { background: transparent; }

QLabel#Badge {
    border: 1px solid #2b313d;
    border-radius: 5px;
    padding: 4px 10px;
    background-color: #181c25;
    color: #646d7e;
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-weight: 500;
}
QLabel#BadgeOnline {
    border: 1px solid #2c5c44;
    border-radius: 5px;
    padding: 4px 10px;
    background-color: #16241d;
    color: #4ec98a;
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-weight: 500;
}
QLabel#BadgeOffline {
    border: 1px solid #2b313d;
    border-radius: 5px;
    padding: 4px 10px;
    background-color: #181c25;
    color: #8b93a4;
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-weight: 500;
}

QWidget#NavRail {
    background-color: #0f131a;
    border-right: 1px solid #272d3a;
}

QWidget#NavIdentity {
    border-bottom: 1px solid #272d3a;
}

QFrame#NavRule {
    background-color: #1b202a;
    border: none;
}

QWidget#NavPower {
    border-top: 1px solid #272d3a;
}

QPushButton#NavItem {
    background-color: transparent;
    border: none;
    border-left: 2px solid transparent;
    border-radius: 5px;
    padding: 6px 9px;
    color: #9aa3b4;
    text-align: left;
    font-weight: 400;
}
QPushButton#NavItem:hover {
    background-color: #1c212c;
    color: #e4e8f0;
}
QPushButton#NavItem:checked {
    background-color: #1a1f29;
    border-left: 2px solid #ff9f45;
    color: #e4e8f0;
    font-weight: 500;
}

QPushButton#Place {
    background-color: transparent;
    border: none;
    border-left: 2px solid transparent;
    border-radius: 5px;
    padding: 0px;
    min-height: 30px;
}
QPushButton#Place:hover { background-color: #1c212c; }
QPushButton#Place:checked {
    background-color: #1a1f29;
    border-left: 2px solid #ff9f45;
}
QLabel#PlaceLabel { color: #9aa3b4; font-size: 12px; }
QLabel#PlaceLabel[on="true"] { color: #e4e8f0; font-weight: 500; }
QLabel#PlaceGlyph { color: #646d7e; font-size: 11px; }
QLabel#PlaceGlyph[on="true"] { color: #ff9f45; }

QWidget#ContentBar {
    background-color: #151922;
    border-bottom: 1px solid #272d3a;
}

QWidget#StatusStrip {
    background-color: #10141b;
    border-top: 1px solid #272d3a;
}

QStatusBar {
    background-color: #10141b;
    border-top: 1px solid #272d3a;
    color: #646d7e;
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 10px;
}
QStatusBar::item { border: none; }

QWidget#WarnStrip {
    background-color: #1d1712;
    border-bottom: 1px solid #a8672a;
}
QWidget#WarnStripCritical {
    background-color: #1f1315;
    border-bottom: 1px solid #6b2f32;
}
QLabel#WarnText { color: #f0c393; }
QLabel#WarnTextCritical { color: #f0b0b2; }

QWidget#ApplyBar {
    background-color: #1d1712;
    border-top: 1px solid #a8672a;
}

QMenu {
    background-color: #151922;
    border: 1px solid #272d3a;
    padding: 4px;
}
QMenu::item {
    padding: 5px 22px 5px 12px;
    border-radius: 4px;
}
QMenu::item:selected { background-color: #242a37; }
QMenu::separator {
    height: 1px;
    background: #272d3a;
    margin: 4px 6px;
}

QToolBar {
    background: transparent;
    border: none;
    spacing: 4px;
}
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
    color: #9aa3b4;
}
QToolButton:hover {
    background-color: #1c212c;
    border-color: #272d3a;
    color: #e4e8f0;
}
QToolButton[popupMode="2"] {
    padding-right: 20px;
}
QToolButton::menu-indicator {
    image: url(:/lsw/caret.png);
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 6px;
    width: 8px;
    height: 5px;
}

QWizard, QWizardPage { background-color: #0d0f14; }

QWidget#qt_wizard_header {
    background-color: #151922;
    border-bottom: 1px solid #272d3a;
}
QLabel#qt_wizard_titleLabel {
    color: #e4e8f0;
    font-size: 16px;
    font-weight: 600;
}
QLabel#qt_wizard_subTitleLabel {
    color: #9aa3b4;
}

QFrame#WizardHead {
    background-color: #151922;
    border-bottom: 1px solid #272d3a;
}
QLabel#WizardTitle {
    font-size: 19px;
    font-weight: 600;
}

QFrame#WizardFoot {
    background-color: #151922;
    border-top: 1px solid #272d3a;
}
QLabel#StepCounter {
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 11px;
    color: #646d7e;
}
QPushButton#WizNext {
    background-color: #ff9f45;
    border: 1px solid #c97a2d;
    color: #17120b;
    font-weight: 600;
    padding: 6px 16px;
}
QPushButton#WizNext:hover   { background-color: #ffb066; }
QPushButton#WizNext:disabled {
    background-color: #4a3a26;
    border-color: #4a3a26;
    color: #8a7358;
}
QPushButton#WizBack, QPushButton#WizCancel {
    padding: 6px 16px;
}
QPushButton#WizCancel {
    background-color: transparent;
    border-color: transparent;
    color: #9aa3b4;
}

QFrame#WizardSideFoot {
    border-top: 1px solid #272d3a;
}
QLabel#RailHost, QLabel#RailFree {
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 11px;
    color: #646d7e;
}

QFrame#DialogFoot {
    background-color: #151922;
    border-top: 1px solid #272d3a;
}

QLabel#Pill, QLabel#PillRun, QLabel#PillDone, QLabel#PillFail, QLabel#PillWarn {
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 11px;
    font-weight: 500;
    border-radius: 9px;
    padding: 2px 8px;
}
QLabel#Pill     { color: #646d7e; border: 1px solid #2b313d; background-color: #181c25; }
QLabel#PillRun  { color: #5aa9f0; border: 1px solid #2b4a6b; background-color: #16202c; }
QLabel#PillDone { color: #4ec98a; border: 1px solid #2c5c44; background-color: #16241d; }
QLabel#PillFail { color: #f2555a; border: 1px solid #6b2f32; background-color: #24181a; }
QLabel#PillWarn { color: #ff9f45; border: 1px solid #a8672a; background-color: #1d1712; }

QLabel#Caption[tone="amber"], QLabel#Meta[tone="amber"] { color: #ff9f45; }
QLabel#Meta[tone="bad"] { color: #f2555a; }
QLabel#Body[tone="warm"] { color: #f0c393; }
QLabel[tone="ok"] { color: #4ec98a; }
QLabel[tone="amber"] { color: #ff9f45; }
QLabel[tone="bad"] { color: #f2555a; }
QLabel[tone="faint"] { color: #646d7e; }

QPushButton[tone="info"]  { color: #5aa9f0; }
QPushButton[tone="amber"] { color: #ff9f45; }
QPushButton[tone="bad"]   { color: #f2555a; }

QLabel#Meta[tone="restart"], QLabel#Meta[tone="now"] {
    border-radius: 2px;
    padding: 0px 4px;
}
QLabel#Meta[tone="restart"] { color: #ff9f45; border: 1px solid #a8672a; }
QLabel#Meta[tone="now"]     { color: #4ec98a; border: 1px solid #2c5c44; }

QWidget#WizardSide {
    background-color: #10141b;
    border-right: 1px solid #272d3a;
}

QListWidget#WizardSteps {
    background: transparent;
    border: none;
    outline: none;
}
QListWidget#WizardSteps::item:hover {
    background-color: #161c26;
}
QListWidget#WizardSteps::item {
    padding: 6px 10px;
    border-left: 2px solid transparent;
    border-radius: 0px;
    color: #646d7e;
}
QListWidget#WizardSteps::item:selected {
    background-color: #161c26;
    border-left: 2px solid #ff9f45;
    color: #e4e8f0;
}

QFrame#Segmented {
    background-color: #0f131a;
    border: 1px solid #272d3a;
    border-radius: 5px;
}

QWidget#ItemRow {
    border-bottom: 1px solid #1b202a;
}
QWidget#ItemRow[last="true"] {
    border-bottom: none;
}
QLabel#ItemName {
    font-size: 13px;
}
QLabel#ItemName[tone="dim"] {
    color: #9aa3b4;
}
QLabel#ItemNote {
    font-size: 11px;
    color: #9aa3b4;
}
QLabel#ItemNote[tone="warm"] {
    color: #f0c393;
}
QLabel#ItemNote[tone="bad"] {
    color: #f2555a;
}

QLabel#DriveBadge {
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 13px;
    font-weight: 600;
    background-color: #0f131a;
    border: 1px solid #272d3a;
    border-radius: 4px;
    padding: 2px 8px;
}

QLabel#StepChip {
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 11px;
    color: #9aa3b4;
    background-color: #0f131a;
    border: 1px solid #272d3a;
    border-radius: 10px;
    padding: 3px 9px;
}
QLabel#StepChip[tone="ok"] {
    color: #4ec98a;
    border-color: #2c5c44;
    background-color: #16241d;
}
QLabel#StepChip[tone="faint"] {
    color: #646d7e;
}
QLabel#StepChip[tone="bad"] {
    color: #f2555a;
    border-color: #6b2f32;
    background-color: #24181a;
}

QFrame#Panel[danger="true"] {
    border-color: #6b2f32;
}
QWidget#PanelHeader[danger="true"] {
    background-color: #1f1315;
    border-bottom: 1px solid #6b2f32;
}
QLabel#CardName[danger="true"] {
    color: #f0b0b2;
}

QPushButton[compact="true"] {
    padding: 2px 9px;
    min-height: 18px;
    font-size: 12px;
}
QComboBox[compact="true"] {
    padding: 3px 8px;
    font-size: 11px;
}

QHeaderView::section {
    border-right: 1px solid transparent;
}
QHeaderView::section:hover {
    border-right: 1px solid #394152;
}
