#version 450
layout(local_size_x = 8) in;
layout(binding = 0, r32ui) uniform writeonly uimage2D img;
layout(push_constant) uniform PC { uint width; uint count; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.count) {
        imageStore(img, ivec2(int(i % pc.width), int(i / pc.width)), uvec4(i * 2654435761u));
    }
}
