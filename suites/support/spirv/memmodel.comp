#version 450
#extension GL_KHR_memory_scope_semantics : require
#pragma use_vulkan_memory_model
layout(local_size_x = 1) in;
layout(std430, binding = 0) buffer Data { uint data[]; };
layout(std430, binding = 1) buffer Flag { uint flag[]; };
layout(std430, binding = 2) buffer Out { uint result[]; };
void main() {
    uint g = gl_WorkGroupID.x;
    uint pair = g >> 1;
    if ((g & 1u) == 0u) {
        data[pair] = 1234u + pair;
        atomicStore(flag[pair], 1u, gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsRelease | gl_SemanticsMakeAvailable);
    } else {
        uint seen = 0u;
        for (uint n = 0u; n < 2000u; ++n) {
            seen = atomicLoad(flag[pair], gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsAcquire | gl_SemanticsMakeVisible);
            if (seen != 0u) {
                break;
            }
        }
        result[pair] = seen == 0u ? 0xFFFFFFFFu : data[pair];
    }
}
