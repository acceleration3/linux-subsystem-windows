#version 450
layout(local_size_x = 8) in;
layout(binding = 0, rgba8) uniform writeonly image2D img;
layout(push_constant) uniform PC { uint width; uint count; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.count) {
        float v = float(i & 255u) / 255.0;
        imageStore(img, ivec2(int(i % pc.width), int(i / pc.width)), vec4(v, 1.0 - v, float((i * 7u) & 255u) / 255.0, 1.0));
    }
}
