#version 450
layout(local_size_x = 8) in;
layout(binding = 0) uniform sampler2D tex;
layout(std430, binding = 1) buffer B { vec4 b[]; };
layout(push_constant) uniform PC { vec2 base; vec2 step; uint count; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.count) {
        b[i] = textureLod(tex, pc.base + pc.step * float(i), 0.0);
    }
}
