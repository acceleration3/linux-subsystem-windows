#version 450
layout(local_size_x_id = 0) in;
layout(constant_id = 1) const uint kMul = 1u;
layout(constant_id = 2) const uint kAdd = 0u;
layout(constant_id = 3) const int kMode = 0;
layout(std430, binding = 0) readonly buffer A { uint a[]; };
layout(std430, binding = 1) buffer B { uint b[]; };
layout(push_constant) uniform PC { uint count; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) {
        return;
    }
    uint v = a[i] * kMul + kAdd;
    if (kMode == 1) {
        v = v ^ (v >> 7);
    } else if (kMode == 2) {
        v = bitfieldReverse(v);
    }
    b[i] = v + gl_WorkGroupSize.x;
}
