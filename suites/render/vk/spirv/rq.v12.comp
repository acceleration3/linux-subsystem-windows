#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT u_tlas;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D u_image;
layout(push_constant) uniform P { vec4 params; } pc;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = (vec2(p) + 0.5) / 64.0 * 2.0 - 1.0;
    vec3 origin = vec3(uv.x * 1.6, uv.y * 1.6, 3.0);
    uint mask = p.x < 32 ? 0x1u : 0x2u;
    if (pc.params.y > 0.5) mask = 0xFFu;
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, u_tlas, gl_RayFlagsNoneEXT, mask, origin, 0.01, vec3(0.0, 0.0, -1.0), 20.0);
    while (rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
            rayQueryConfirmIntersectionEXT(rq);
        }
    }
    vec4 color = vec4(0.04, 0.05, 0.09, 1.0);
    if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        int id = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
        vec2 b = rayQueryGetIntersectionBarycentricsEXT(rq, true);
        float t = rayQueryGetIntersectionTEXT(rq, true);
        vec3 base = id == 0 ? vec3(0.9, 0.4, 0.2) : (id == 1 ? vec3(0.2, 0.7, 0.9) : vec3(0.6, 0.9, 0.3));
        vec3 hit = origin + vec3(0.0, 0.0, -1.0) * t;
        rayQueryEXT shadow;
        rayQueryInitializeEXT(shadow, u_tlas, gl_RayFlagsTerminateOnFirstHitEXT, 0xFF, hit + vec3(0.0, 0.0, 0.02), 0.01, normalize(vec3(0.5, 0.4, 1.0)), 10.0);
        while (rayQueryProceedEXT(shadow)) {}
        float lit = rayQueryGetIntersectionTypeEXT(shadow, true) == gl_RayQueryCommittedIntersectionNoneEXT ? 1.0 : 0.4;
        color = vec4(base * (0.5 + 0.5 * b.x + 0.2 * b.y) * lit, 1.0);
    }
    imageStore(u_image, p, color);
}
