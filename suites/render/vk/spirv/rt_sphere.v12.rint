#version 460
#extension GL_EXT_ray_tracing : require
hitAttributeEXT vec2 sphere_attr;
void main() {
    vec3 center = vec3(0.7, 0.5, 0.0);
    vec3 oc = gl_ObjectRayOriginEXT - center;
    float b = dot(oc, gl_ObjectRayDirectionEXT);
    float c = dot(oc, oc) - 0.25;
    float disc = b * b - c;
    if (disc >= 0.0) {
        float t = -b - sqrt(disc);
        if (t > gl_RayTminEXT && t < gl_RayTmaxEXT) {
            sphere_attr = vec2(0.5, 0.5);
            reportIntersectionEXT(t, 0u);
        }
    }
}
