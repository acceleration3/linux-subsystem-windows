#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D u_image;
layout(push_constant) uniform P { vec4 params; } pc;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (float(p.y) >= pc.params.x) {
        return;
    }
    imageStore(u_image, p, vec4(float(p.x) / 63.0, float(p.y) / 63.0, 0.5 + 0.5 * sin(float(p.x + p.y) * 0.4), 1.0));
}
