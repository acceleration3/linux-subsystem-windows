#version 450
layout(local_size_x = 1) in;
layout(std430, set = 0, binding = 0) buffer Out { vec4 v[]; } o;
layout(push_constant) uniform P { vec4 params; } pc;
void main() {
    float t = pc.params.x;
    for (int i = 0; i < 3; ++i) {
        float a = 6.2831853 * float(i) / 3.0 + t * 0.9;
        o.v[i * 2] = vec4(0.7 * cos(a) * (0.7 + 0.1 * t), 0.7 * sin(a) * (0.7 + 0.1 * t), 0.0, 1.0);
        o.v[i * 2 + 1] = vec4(0.5 + 0.5 * cos(a), 0.5 + 0.5 * sin(a + 1.0), 0.5 + 0.5 * sin(t + float(i)), 1.0);
    }
}
