#version 460
#extension GL_EXT_ray_tracing : require
layout(set = 0, binding = 0) uniform accelerationStructureEXT u_tlas;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D u_image;
layout(location = 0) rayPayloadEXT vec4 payload;
void main() {
    vec2 uv = (vec2(gl_LaunchIDEXT.xy) + 0.5) / vec2(gl_LaunchSizeEXT.xy) * 2.0 - 1.0;
    vec3 origin = vec3(uv.x * 1.6, uv.y * 1.6, 3.0);
    payload = vec4(0.0);
    traceRayEXT(u_tlas, gl_RayFlagsNoneEXT, 0xFF, 0, 0, 0, origin, 0.01, vec3(0.0, 0.0, -1.0), 20.0, 0);
    imageStore(u_image, ivec2(gl_LaunchIDEXT.xy), payload);
}
