function(lsw_render_hash api out_var)
    set(render_dir ${CMAKE_CURRENT_FUNCTION_LIST_DIR})
    file(GLOB scene_common CONFIGURE_DEPENDS ${render_dir}/common/*.cpp ${render_dir}/common/*.hpp)
    list(FILTER scene_common EXCLUDE REGEX "(diff|tolerance|judge_selftest|png|ref_store)\\.[ch]pp$")
    file(GLOB api_files CONFIGURE_DEPENDS ${render_dir}/${api}/*.cpp ${render_dir}/${api}/*.hpp)
    list(FILTER api_files EXCLUDE REGEX "guest_[^/]*$")
    file(GLOB platform_headers CONFIGURE_DEPENDS ${render_dir}/platform/*.hpp)
    set(shader_files "")
    if(api STREQUAL "vk")
        file(GLOB shader_files CONFIGURE_DEPENDS ${render_dir}/vk/spirv/gen/*.cpp)
    endif()
    set(all_files ${scene_common} ${api_files} ${platform_headers} ${shader_files})
    list(SORT all_files)
    set(accumulated "")
    foreach(source IN LISTS all_files)
        file(SHA256 ${source} digest)
        string(APPEND accumulated "${digest}\n")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${source})
    endforeach()
    string(SHA256 combined "${accumulated}")
    string(SUBSTRING "${combined}" 0 16 short)
    set(${out_var} ${short} PARENT_SCOPE)
endfunction()
